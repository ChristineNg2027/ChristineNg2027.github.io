---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PreVisionDiagram from './PreVisionDiagram.astro';
import { withTodos } from '../lib/util';

/** Hero visuals that exist so far, by project id. Others show a placeholder. */
const heroes: Record<string, typeof PreVisionDiagram> = {
  'pre-vision': PreVisionDiagram,
};

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { title, status = '', glance = [], hero } = entry.data;
const { Content } = await render(entry);
const Hero = heroes[entry.id];
---

<Base title={title} description={entry.data.card.line}>
  <article class="project">
    <header class="project-header">
      <h1>{title}</h1>
      <p class="status-tag" set:html={withTodos(status)} />
    </header>

    <dl class="glance" aria-label="At a glance">
      {
        glance.map(({ label, value, href }) => (
          <div>
            <dt>{label}</dt>
            {href ? (
              <dd>
                <a href={href}>{value}</a>
              </dd>
            ) : (
              <dd set:html={withTodos(value)} />
            )}
          </div>
        ))
      }
    </dl>

    {
      hero && (
        <figure class="hero">
          {Hero ? (
            <Hero />
          ) : hero.kind === 'image' && hero.image ? (
            <Image
              class="hero-image"
              src={hero.image}
              alt={hero.alt ?? ''}
              widths={[680, 1360]}
              sizes="(max-width: 712px) 100vw, 680px"
              format="webp"
              loading="eager"
            />
          ) : (
            <div class="hero-placeholder" aria-hidden="true" />
          )}
          <figcaption set:html={withTodos(hero.caption)} />
        </figure>
      )
    }

    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
