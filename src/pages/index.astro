---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PreVisionDiagram from '../components/PreVisionDiagram.astro';
import portrait from '../assets/christine-ng.jpg';
import { site } from '../site';
import { url, isTodo, withTodos } from '../lib/util';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const plainName = site.name.replace(/\s*\[\[TODO\b[\s\S]*?\]\]/g, '');
---

<Base title={plainName} showHeader={false}>
  <div class="intro">
    <Image
      class="portrait"
      src={portrait}
      alt="Portrait of Christine Ng"
      width={360}
      widths={[240, 360]}
      sizes="(max-width: 600px) 120px, 180px"
      format="webp"
      quality={80}
      loading="eager"
    />
    <div class="intro-text">
      <h1 set:html={withTodos(site.name)} />
      <section class="bio" aria-label="About me">
        <p>
          Hi! I'm Christine, a Computer Science student at the University of Washington who's excited about{' '}
          <strong>multimodal AI, embodied intelligence, and human-AI interaction</strong>.
        </p>
        <p>
          I'm fascinated by how much we communicate through the ways we move, interact, and experience the world, often
          without saying a word. This makes me curious about how we can build intelligent systems that go beyond simply
          recognizing what they see, hear, or feel to understanding what's happening around us, anticipating what people
          might need, and offering help at the right moment.
        </p>
        <p>
          I've had the opportunity to explore these questions through several research projects. At UW's{' '}
          <strong>Programmable Matter Lab</strong>, I work on{' '}
          <a href={url('wire-bending/')}>computer vision and 3D reconstruction for computational fabrication</a>. At the{' '}
          <strong>Wearable Intelligence Lab</strong>, I'm exploring how machine learning can help interpret tactile and
          force signals for sensor-enabled medical palpation. I'm also working on{' '}
          <a class="nowrap" href={url('pre-vision/')}><strong>Pre-Vision</strong></a>, an independent project investigating how visual
          and auditory cues can help AI anticipate human actions and provide timely assistance.
        </p>
        <p>
          What excites me most is bringing these ideas together to create technology that feels more natural to interact
          with. I'm always eager to learn, explore new perspectives, and collaborate with people from different
          backgrounds to make intelligent systems more intuitive, adaptive, and accessible.
        </p>
        <p>
          Outside of research, I enjoy playing piano, discovering new music, and baking. I'm always happy to exchange music
          recommendations!
        </p>
      </section>
    </div>
  </div>

  <nav class="links" aria-label="Links">
    <ul>
      <li><a href={url(site.cv)}>CV (PDF)</a></li>
      <li>
        {isTodo(site.github) ? <span set:html={`GitHub ${withTodos(site.github)}`} /> : <a href={site.github}>GitHub</a>}
      </li>
      <li>
        {
          isTodo(site.email) ? (
            <span set:html={`Email ${withTodos(site.email)}`} />
          ) : (
            <a href={`mailto:${site.email}`}>Email</a>
          )
        }
      </li>
      {
        site.extraLinks.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>

  <section aria-labelledby="projects-heading">
    <h2 id="projects-heading">Projects</h2>
    <ul class="cards">
      {
        projects.map((p) => (
          <li class="card">
            {/* Card images are decorative: the title link and text carry the meaning. */}
            {p.id === 'pre-vision' ? (
              <div class="card-image card-image--diagram">
                <PreVisionDiagram layout="wide" decorative />
              </div>
            ) : p.data.card.image ? (
              <Image class="card-image" src={p.data.card.image} alt="" widths={[680, 1360]} sizes="(max-width: 712px) 100vw, 680px" format="webp" />
            ) : (
              <div class="card-image placeholder-box" set:html={withTodos('[[TODO: card image]]')} />
            )}
            <div class="card-body">
              <h3>
                {p.data.link ? (
                  <a href={p.data.link}>
                    {p.data.title}{' '}
                    <span class="ext">
                      code on GitHub<span aria-hidden="true"> ↗</span>
                    </span>
                  </a>
                ) : (
                  <a href={url(`${p.id}/`)}>{p.data.title}</a>
                )}
              </h3>
              <p set:html={withTodos(p.data.card.line)} />
              <p class="card-meta" set:html={withTodos(p.data.card.meta)} />
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
